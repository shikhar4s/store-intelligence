API_PORT=8000
ENVIRONMENT=production
STORE_DB_URL=sqlite:///./data/store_intelligence.db
DEFAULT_STORE_ID=STORE_BLR_002
INGEST_BATCH_LIMIT=500
STALE_FEED_MINUTES=10
POS_CORRELATION_MINUTES=5
BILLING_ABANDON_MINUTES=5
REENTRY_TTL_MINUTES=30
LAYOUT_CONFIG_PATH=configs/store_layout.generated.json
YOLO_CONFIG_DIR=.ultralytics

# Docker image option. Keep false for lightweight API-only startup.
# Set true when you want the container to install OpenCV + Ultralytics for detection/video demo.
INSTALL_CV=false
